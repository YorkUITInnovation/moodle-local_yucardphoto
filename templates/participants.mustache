{{!
    @template local_yucardphoto/participants

    YU Card Photo Roster page — responsive, searchable, sortable, paginated
    grid of student photos for a course.

    Classes required:
    * none

    Data attributes required:
    * none

    Context variables required:
    * coursefullname    string  Full name of the course (already formatted/escaped).
    * pagetitle         string  Page <h2> title string (already formatted/escaped).
    * backurl           string  URL back to the Participants (user/index.php) page.
    * backlabel         string  Localised "Back to Participants" label.
    * formaction        string  Form action URL (this page, without query params).
    * courseid          int     Course ID (hidden form field).
    * searchvalue       string  Current search term (HTML-escaped).
    * searchlabel       string  Localised "Search students" label.
    * searchplaceholder string  Localised placeholder text.
    * sortoptions       array   [{value, label, selected}] sort dropdown options.
    * sortlabel         string  Localised "Sort by" label.
    * perPageOptions    array   [{value, label, selected}] per-page dropdown options.
    * perpagelabel      string  Localised "Photos per page" label.
    * searchbtnlabel    string  Localised submit button label.
    * countlabel        string  Localised count string e.g. "45 users".
    * hasstudents       bool    True when the students array is non-empty.
    * students          array   [{firstname, lastname, sisid, email, photourl, alttext}]
    * noresultsmsg      string  Message shown when hasstudents is false.
    * pagingbar         string  Rendered HTML paging bar (from $OUTPUT->render()).

    Example context (json):
    {
        "coursefullname": "Introduction to Computing",
        "pagetitle": "Photo Roster — Introduction to Computing",
        "backurl": "/user/index.php?id=5",
        "backlabel": "Back to Participants",
        "formaction": "/local/yucardphoto/participants.php",
        "courseid": 5,
        "searchvalue": "",
        "searchlabel": "Search students",
        "searchplaceholder": "First name, last name or student ID\u2026",
        "sortoptions": [
            {"value": "lastname",  "label": "Last name",   "selected": true},
            {"value": "firstname", "label": "First name",  "selected": false},
            {"value": "email",     "label": "Email",       "selected": false},
            {"value": "sisid",     "label": "Student ID",  "selected": false}
        ],
        "sortlabel": "Sort by",
        "perPageOptions": [
            {"value": 20,  "label": "4 \u00d7 5 (20 per page)", "selected": true},
            {"value": 100, "label": "All (max 100 per page)",   "selected": false}
        ],
        "perpagelabel": "Photos per page",
        "searchbtnlabel": "Search",
        "countlabel": "3 users",
        "hasstudents": true,
        "students": [
            {
                "firstname": "Jane",
                "lastname": "Smith",
                "sisid": "212345678",
                "email": "jsmith@example.com",
                "photourl": "/pluginfile.php/1/local_yucardphoto/photos/123/212345678.jpg",
                "alttext": "Jane Smith"
            }
        ],
        "noresultsmsg": "",
        "pagingbar": ""
    }
}}

{{! ── Moodle-style page header: icon + title (left), course breadcrumb (right) ── }}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        <span class="ycp-page-icon" aria-hidden="true">
            {{#pix}} photo-camera, local_yucardphoto {{/pix}}
        </span>
        <h1 class="h3 mb-0">{{#str}} coursesettings_heading, local_yucardphoto {{/str}}</h1>
    </div>
    {{! Course name (links to participants page) → current page name }}
    <nav aria-label="{{#str}} pagepath, core {{/str}}" class="ycp-header-nav">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item">
                <a href="{{backurl}}">{{coursefullname}} {{backlabel}}</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                {{#str}} coursesettings_heading, local_yucardphoto {{/str}}
            </li>
        </ol>
    </nav>
</div>

{{! ── Back to Participants button — commented out; breadcrumb handles navigation ── }}
<div class="ycp-page-header mb-3 d-flex justify-content-end">
    <a href="{{backurl}}" class="btn btn-secondary">
        {{backlabel}}
    </a>
</div>

{{! ── Page summary alert ─────────────────────────────────────────────────── }}
<div class="alert alert-info d-flex align-items-start gap-2 mt-4" role="note">
    <span aria-hidden="true">&#8505;</span>
    <span>
        {{{pageinfohtml}}}
    </span>
</div>

{{! ── Students section ───────────────────────────────────────────────────── }}
<div class="ycp-students-section mt-6">
    <h3 class="mb-3 border-bottom pb-2">{{#str}} students, local_yucardphoto {{/str}}</h3>

    {{! ── Controls bar ────────────────────────────────────────────────── }}
    {{! Search form and initials selector are sibling elements — the initials selector
        renders its own <form> internally (initialsdropdownform), so it must NOT be
        nested inside the search <form>. Nested forms are invalid HTML and cause the
        initials JS navigation to submit the outer form instead of redirecting. }}
    <div class="d-flex align-items-center gap-2 w-100 mb-2 flex-wrap" data-region="ycp-controls">

        {{! Search form (only wraps the search input + submit button) }}
        <form method="get" action="{{formaction}}" class="mt-2 ycp-search-wrapper">
            <input type="hidden" name="id" value="{{courseid}}">
            <input type="hidden" name="sort" value="{{sortvalue}}">
            <input type="hidden" name="perpage" value="{{perpagevalue}}">
            <input type="hidden" name="sifirst" value="{{sifirst}}">
            <input type="hidden" name="silast" value="{{silast}}">
            <input type="hidden" name="nophotoonly" value="{{nophotoonly}}">
            <input type="hidden" name="page" value="0">
            <div class="input-group" role="search">
                <input type="search"
                       id="ycp-search"
                       name="search"
                       value="{{searchvalue}}"
                       placeholder="{{searchplaceholder}}"
                       class="form-control"
                       autocomplete="off"
                       aria-label="{{searchlabel}}"
                       aria-describedby="ycp-search-btn">
                <button class="btn btn-outline-secondary"
                        id="ycp-search-btn"
                        type="submit"
                        aria-label="{{searchlabel}}">
                    {{#pix}} a/search, core {{/pix}}
                </button>
            </div>
        </form>

        <div class="vr text-secondary opacity-50 mt-2" aria-hidden="true"></div>

        {{! Filter by name initials — Moodle core initials selector popup.
            Must be a sibling of the search form, NOT inside it. }}
        <div class="mt-2 flex-shrink-0">
            {{{initialselector}}}
        </div>

    </div>

    {{! ── Result count + clear search + clear filter + missing photo badge ── }}
    <div class="d-flex flex-wrap align-items-center gap-3 mt-2 mb-4">
        <span class="text-muted small">{{countlabel}}</span>
        {{#issearching}}
        <a href="{{clearsearchurl}}" class="small text-decoration-none">
            {{#pix}} e/cancel, core {{/pix}} {{#str}} clearsearch, core {{/str}}
        </a>
        {{/issearching}}
        {{#isfiltering}}
        <a href="{{clearfilterurl}}" class="small text-decoration-none">
            {{#pix}} e/cancel, core {{/pix}} {{#str}} clearfilters, core {{/str}}
        </a>
        {{/isfiltering}}
        {{#hasnophoto}}
        <a href="{{nophotourl}}"
           class="badge text-decoration-none {{#nophotofilteractive}}bg-secondary text-white{{/nophotofilteractive}}{{^nophotofilteractive}}bg-warning text-dark{{/nophotofilteractive}}"
           title="{{nophototitle}}">
            &#9888; {{nophotolabel}}
        </a>
        {{/hasnophoto}}
    </div>

    {{! ── Photo grid ──────────────────────────────────────────────────── }}
    {{#hasstudents}}
    <div class="ycp-photo-grid row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-4 g-3"
         role="list"
         data-region="ycp-grid">
        {{#students}}
        <div class="col" role="listitem">
            <div class="card h-100 text-center ycp-student-card">

                {{! Photo }}
                <div class="card-img-top d-flex justify-content-center align-items-center pt-3 position-relative">
                    <button type="button"
                            class="btn p-0 border-0 bg-transparent"
                            data-action="ycp-enlarge-photo"
                            data-bs-toggle="modal"
                            data-bs-target="#ycp-photo-modal"
                            data-photo-src="{{photourl}}"
                            data-photo-alt="{{alttext}}"
                            data-photo-name="{{lastname}}, {{firstname}}"
                            aria-label="{{enlargephotolabel}}">
                        <img src="{{photourl}}"
                             alt="{{alttext}}"
                             width="100"
                             height="100"
                             class="rounded-circle ycp-photo{{#nophoto}} ycp-photo-missing{{/nophoto}}"
                             style="object-fit: cover;">
                    </button>
                    {{#nophoto}}
                    <span class="badge bg-warning text-dark position-absolute bottom-0 ycp-missing-badge"
                          title="{{nophotobadgetitle}}">&#9888; {{nophotobadgetext}}</span>
                    {{/nophoto}}
                </div>

                {{! Student details }}
                <div class="card-body p-2">
                    <p class="mb-1 small"><strong>{{lastname}}, {{firstname}}</strong></p>
                    {{#sisid}}
                        <p class="text-muted small mb-0">{{sisid}}</p>
                    {{/sisid}}
                    <p class="mb-0">
                        <a href="mailto:{{email}}" class="small text-truncate d-block">{{email}}</a>
                    </p>
                </div>

            </div>
        </div>
        {{/students}}
    </div>
    {{/hasstudents}}

    {{^hasstudents}}
    <div class="alert alert-info" role="alert">
        {{noresultsmsg}}
    </div>
    {{/hasstudents}}

    {{! ── Paging bar ───────────────────────────────────────────────────── }}
    {{#pagingbar}}
        {{{pagingbar}}}
    {{/pagingbar}}

    {{! ── Show all / show paged link ─────────────────────────────────── }}
    {{#hasstudents}}
    <div class="mt-2 mb-1">
        <a href="{{showallurl}}" class="small">{{showalllabel}}</a>
    </div>
    {{/hasstudents}}

</div>{{! end .ycp-students-section }}

{{! ── Photo enlargement modal ───────────────────────────────────────────── }}
<div class="modal fade" id="ycp-photo-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" data-region="ycp-modal-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{closemodal}}"></button>
            </div>
            <div class="modal-body text-center">
                <img src=""
                     alt=""
                     class="img-fluid rounded"
                     data-region="ycp-modal-image">
            </div>
        </div>
    </div>
</div>







